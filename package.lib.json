{
  "name": "@khraben/flowui",
  "version": "1.0.3",
  "description": "FlowUI - Modern React component library with TypeScript and CSS-in-JS",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
  "sideEffects": false,
  "files": ["index.js", "index.mjs", "index.d.ts", "index.d.mts", "*.map"],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.562.0",
    "react-datepicker": "^9.1.0"
  },
  "overrides": {
    "closure-net": "npm:noop-package@^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khraben/FlowUI.git"
  },
  "keywords": ["react", "components", "ui", "css-in-js", "typescript"],
  "author": "khraben",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
