{
  "name": "@khraben/flowui",
  "version": "0.2.3",
  "description": "FlowUI - Modern React component library with TypeScript and Tailwind CSS",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "*.map"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "react-datepicker": "^9.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khraben/FlowUI.git"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "typescript"
  ],
  "author": "khraben",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
