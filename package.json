{
  "name": "@khraben/flowui",
  "version": "1.0.4",
  "private": false,
  "description": "FlowUI - React component library with 100% customizable colors via props and CSS-in-JS",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khraben/FlowUI.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "typescript",
    "css-in-js"
  ],
  "author": "Khraben",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "rm -rf dist && tsup && cp package.lib.json dist/package.json && cp README.md LICENSE dist/",
    "start": "next start",
    "lint": "eslint",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.562.0",
    "react-datepicker": "^9.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "overrides": {
    "closure-net": "npm:noop-package@^1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "next": "16.1.4",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "typescript": "^5"
  }
}
